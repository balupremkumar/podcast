# LLM backend: "claude" (default) or "local" (LM Studio)
LLM_PROVIDER=claude

# Required for LLM_PROVIDER=claude
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Required for production-grade speaker diarisation (optional — falls back to VAD)
# Accept the model license at https://hf.co/pyannote/speaker-diarization-3.1
HF_TOKEN=hf_...

# Only needed if LLM_PROVIDER=local
LM_STUDIO_URL=http://localhost:1234
LM_STUDIO_MODEL=qwen2.5-14b-instruct

# Whisper model size: tiny, base (default), small, medium, large-v3
# Larger = more accurate, slower. base is good for demo.
WHISPER_MODEL=base

# Chatterbox TTS server (for cold open audio synthesis)
CHATTERBOX_URL=http://localhost:8004
